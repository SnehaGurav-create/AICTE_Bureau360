# -------------------------------------------------------
# Bureau360 Backend — Environment Variables
# Copy this file to .env and fill in the values.
# -------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://bureau360:bureau360@localhost:5433/bureau360

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=200

# SMTP (use Ethereal / Mailtrap for development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bureau360.aicte.gov.in

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5

# Overlap Detection
OVERLAP_SIMILARITY_THRESHOLD=0.4

# Seed Admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@aicte.gov.in
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# Logging
LOG_LEVEL=debug
